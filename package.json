{
  "name": "webiston",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/extensions/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack --port 9999",
    "prebuild": "pnpm packages:build",
    "build": "next build",
    "postbuild": "node scripts/update-tools-list.js && next-sitemap && node scripts/build-search-index.js",
    "update-tools": "node scripts/update-tools-list.js",
    "start": "next start",
    "lint": "oxlint src/ packages/ apps/",
    "lint:fix": "oxlint src/ packages/ apps/ --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install && pnpm packages:build",
    "ext:dev": "pnpm --filter latin-cyrillic-extension dev",
    "ext:build": "pnpm --filter latin-cyrillic-extension build",
    "ext:zip": "pnpm --filter latin-cyrillic-extension zip",
    "ext:store": "node scripts/store-screenshots.mjs",
    "packages:build": "pnpm --filter '@webiston/*' build",
    "themes": "node scripts/theme-palette.mjs",
    "tokens": "node scripts/token-guardrail.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "i18n": "node scripts/i18n-parity.mjs",
    "ext:build:all": "pnpm --filter latin-cyrillic-extension build:all",
    "ext:zip:all": "pnpm --filter latin-cyrillic-extension zip:all"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@webiston/transliteration": "workspace:*",
    "@webiston/ui": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "flexsearch": "^0.8.212",
    "framer-motion": "^13.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.18.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-media-recorder": "^1.7.2",
    "react-medium-image-zoom": "^5.4.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
