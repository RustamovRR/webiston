{
  "name": "webiston",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/extensions/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack --port 9999",
    "build": "turbo build",
    "postbuild": "node scripts/update-tools-list.js && next-sitemap && node scripts/build-search-index.js",
    "update-tools": "node scripts/update-tools-list.js",
    "start": "next start",
    "lint": "turbo lint",
    "lint:fix": "oxlint src/ packages/ apps/ --fix",
    "format": "biome format --write .",
    "format:check": "turbo format:check",
    "check": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo clean",
    "prepare": "lefthook install",
    "ext:dev": "pnpm --filter latin-cyrillic-extension dev",
    "ext:build": "pnpm --filter latin-cyrillic-extension build",
    "ext:zip": "pnpm --filter latin-cyrillic-extension zip",
    "packages:build": "pnpm --filter '@webiston/*' build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "@webiston/transliteration": "workspace:*",
    "@webiston/ui": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "file-saver": "^2.0.5",
    "flexsearch": "^0.8.212",
    "framer-motion": "^12.38.0",
    "fs-extra": "^11.3.5",
    "gray-matter": "^4.0.3",
    "hast": "^1.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.16.45",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "medium-zoom": "^1.1.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-media-recorder": "^1.7.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/hast": "^3.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "oxlint": "^1.64.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.9.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
